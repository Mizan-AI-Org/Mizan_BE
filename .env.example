# DATABASE
DB_NAME=mizan_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=your_rds_host
DB_PORT=5432

# DJANGO
SECRET_KEY=generate_a_new_secure_secret_key
DEBUG=False
ALLOWED_HOSTS=api.heymizan.ai,app.heymizan.ai
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'


# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# WHATSAPP
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# For staff activation wa.me link: actual WhatsApp number in E.164 digits (e.g. 212784476751). Do not use PHONE_NUMBER_ID here.
WHATSAPP_ACTIVATION_WA_PHONE=212784476751
AUTO_WHATSAPP_INVITES=True
SUPPORT_CONTACT=+212663069292

# Miya WhatsApp templates (Meta-approved names; must match WhatsApp Business Manager)
WHATSAPP_TEMPLATE_INVITE=onboarding_invite_v1
WHATSAPP_TEMPLATE_STAFF_ACTIVATED_WELCOME=staff_activated_welcome
WHATSAPP_TEMPLATE_STAFF_ACTIVATED_WELCOME_HAS_HEADER=False
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED=staff_weekly_schedule
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED_LANGUAGE=en_US
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED_DETAILED=
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED_DETAILED_LANGUAGE=en_US
WHATSAPP_TEMPLATE_STAFF_CLOCK_IN=staff_clock_in
WHATSAPP_TEMPLATE_CLOCK_IN_LOCATION=clock_in_location_request
WHATSAPP_TEMPLATE_CLOCK_IN_SUCCESSFUL=clock_in_success
WHATSAPP_TEMPLATE_STAFF_CHECKLIST=staff_checklist

# Published WhatsApp Flow IDs (Meta Business Suite → WhatsApp Manager → Flows)
LEAVE_REQUEST_FLOW_ID=151961231845018
INCIDENT_REPORT_FLOW_ID=1322819756651058
# Set after publishing agents/flows/clock_in.flow.json in Meta WhatsApp Manager
CLOCK_IN_FLOW_ID=


# LUA AGENT (webhook integration — agent code lives in github.com/Mizan-AI-Org/Miya)
LUA_API_KEY=
LUA_AGENT_ID=
LUA_WEBHOOK_API_KEY=

# Fish Audio — Miya voice (https://fish.audio/app/)
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro

# Miya agent (OpenAI reasoning; voice via Fish Audio above)
MIYA_CHAT_MODEL=gpt-4o-mini
MIYA_AGENT_API_BASE=http://127.0.0.1:8000
MIYA_WHATSAPP_ENABLED=True
MIYA_WHATSAPP_VOICE_DEFAULT=False

# OTHER
OPENAI_API_KEY=
CELERY_BROKER_URL=redis://your_redis_host:6379/0
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform Admin (/admin) — comma-separated emails that get ops access
PLATFORM_OPS_EMAILS=you@heymizan.ai
# Optional: also grant Django superuser (can add other operators)
PLATFORM_OPS_SUPERUSER_EMAILS=you@heymizan.ai
# Password for /admin sign-in (creates user if missing; applied on API restart)
PLATFORM_OPS_PASSWORD=

# =============================
# MEDIA STORAGE (optional S3)
# =============================
# Leave unset for local MEDIA_ROOT. When AWS_STORAGE_BUCKET_NAME (or S3_BUCKET)
# is set, WhatsApp checklist / task-proof / incident photos go to S3 via django-storages.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_STORAGE_BUCKET_NAME=
# S3_BUCKET=
# Optional CDN / custom domain for public URLs:
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=True
