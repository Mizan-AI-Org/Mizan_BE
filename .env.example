# =============================================================================
# Mizan Backend — copy to .env and fill in values (never commit .env)
#
# [1] MIYA (Mastra)  OpenAI + Fish Audio + MIYA_* + MIYA_MASTRA_API_KEY
# [2] WHATSAPP      Meta Cloud API for +212784476751
# [3] PLATFORM OPS  /admin login
# [4] CORE          Django, Postgres, Redis, email
# [5] INTEGRATIONS  Square, Google, Stripe, S3, etc.
# =============================================================================


# --- [1] NEW MIYA ---
OPENAI_API_KEY=
MIYA_CHAT_MODEL=gpt-4o-mini
MIYA_AGENT_API_BASE=http://127.0.0.1:8000
MIYA_WHATSAPP_ENABLED=True
MIYA_WHATSAPP_VOICE_DEFAULT=False
# Keep False — Meta inbound webhook is Django. Brain = MIYA_AGENT_PROVIDER.
MIYA_WHATSAPP_MASTRA_CHANNEL=False
# Agent brain: django | mastra (Miya-V2 on Mastra Cloud — see ../Miya-V2/README.md)
MIYA_AGENT_PROVIDER=mastra
# Local dev: http://127.0.0.1:4111  |  Production: Server URL from `npm run deploy`
# Mastra Cloud (production default — override for local dev)
MIYA_MASTRA_URL=https://mizan-miya-mastra.server.mastra.cloud
MIYA_MASTRA_AGENT_ID=miya
MIYA_MASTRA_API_KEY=
MIYA_MASTRA_API_TOKEN=
MASTRA_API_TOKEN=
MIYA_MASTRA_TIMEOUT=120
# Async Miya chat (Celery) — webhook returns immediately; reply sent when agent finishes
MIYA_ASYNC_CHAT=True
# Mastra bridge cache TTLs (seconds)
MIYA_CACHE_TTL_WHATSAPP_CTX=300
MIYA_CACHE_TTL_TOOL=90
MIYA_CACHE_TTL_CONTEXT=120
MIYA_MASTRA_HEALTH_CACHE_TTL=30
# FISH_AUDIO_REFERENCE_ID default = "Sarah" (warm, young, friendly female
# voice; cross-lingual — same voice speaks EN/FR/AR/Darija). Leave as-is
# unless you want a different voice from https://fish.audio/discover
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=933563129e564b19a115bedd57b7406a
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_VOICE_SPEED=1.05
FISH_AUDIO_VOICE_LABEL=Sarah
OPENAI_TTS_VOICE=shimmer


# --- [2] WHATSAPP ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_ACTIVATION_WA_PHONE=212784476751
WHATSAPP_DEFAULT_COUNTRY_CODE=212
PUBLIC_API_BASE_URL=https://api.heymizan.ai
AUTO_WHATSAPP_INVITES=True
SUPPORT_CONTACT=+212663069292
WHATSAPP_TEMPLATE_MANAGER_MESSAGE=manager_message
WHATSAPP_TEMPLATE_MANAGER_MESSAGE_LANGUAGE=fr
WHATSAPP_TEMPLATE_INVITE=onboarding_invite_v1
WHATSAPP_TEMPLATE_STAFF_ACTIVATED_WELCOME=staff_activated_welcome
WHATSAPP_TEMPLATE_STAFF_ACTIVATED_WELCOME_HAS_HEADER=False
WHATSAPP_TEMPLATE_STAFF_CLOCK_IN=staff_clock_in
WHATSAPP_TEMPLATE_CLOCK_IN_LOCATION=clock_in_location_request
WHATSAPP_TEMPLATE_CLOCK_IN_SUCCESSFUL=clock_in_success
WHATSAPP_TEMPLATE_STAFF_CHECKLIST=staff_checklist
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED=staff_weekly_schedule
WHATSAPP_TEMPLATE_SHIFT_ASSIGNED_LANGUAGE=en_US
WHATSAPP_TEMPLATE_FALLBACK_TO_TEXT=true
LEAVE_REQUEST_FLOW_ID=
INCIDENT_REPORT_FLOW_ID=
# CLOCK_IN_FLOW_ID=


# --- [3] PLATFORM ADMIN ---
PLATFORM_OPS_EMAILS=ops@heymizan.ai
PLATFORM_OPS_SUPERUSER_EMAILS=ops@heymizan.ai
PLATFORM_OPS_PASSWORD=


# --- [4] CORE ---
SECRET_KEY=generate_a_new_secure_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,app.heymizan.ai,api.heymizan.ai
FRONTEND_URL=http://localhost:8080
POSTGRES_DB=mizan
POSTGRES_USER=mizan_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FIREBASE_SERVICE_ACCOUNT_KEY={}


# --- [5] INTEGRATIONS (optional) ---
# WHATSAPP_TEMPLATE_FALLBACK_TO_TEXT=true  # intelligent free-form when Meta template missing
# SQUARE_*, GOOGLE_OAUTH_*, STRIPE_*, AWS_*, LIGHTSPEED_API_BASE=
