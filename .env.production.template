# Production Environment Variables for Mizan Backend
# On EC2: copy this to `.env`, fill in values — Docker Compose loads `.env` directly.

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
SECRET_KEY=your-secure-secret-key-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=3.64.55.137,api.heymizan.ai,localhost

# =============================================================================
# DATABASE (RDS PostgreSQL)
# =============================================================================
POSTGRES_DB=mizan
POSTGRES_USER=mizan_user
POSTGRES_PASSWORD=your-rds-password
POSTGRES_HOST=your-rds-endpoint.rds.amazonaws.com
POSTGRES_PORT=5432

# =============================================================================
# REDIS & CELERY (Managed by Docker Compose, use service name 'redis')
# =============================================================================
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# =============================================================================
# EMAIL (Zoho Mail SMTP)
# =============================================================================
# Recommended:
# - TLS:  smtp.zoho.com :587  (EMAIL_USE_TLS=True)
# - SSL:  smtp.zoho.com :465  (EMAIL_USE_SSL=True)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=sales@heymizan.ai
EMAIL_HOST_PASSWORD=your-zoho-app-password
DEFAULT_FROM_EMAIL=sales@heymizan.ai

# =============================================================================
# WHATSAPP CLOUD API
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=930508853476059
WHATSAPP_ACCESS_TOKEN=EAARNWzw0MMYBQ...your-full-token
WHATSAPP_API_VERSION=v22.0
WHATSAPP_BUSINESS_ACCOUNT_ID=1353791455957400
WHATSAPP_VERIFY_TOKEN=mizan-whatsapp-token-20260105
# Outside Meta's 24h window, Staff Messages uses this approved UTILITY template
# (body param {{1}} = full manager message). Must match Meta/Lua template name.
WHATSAPP_TEMPLATE_MANAGER_MESSAGE=manager_message
WHATSAPP_TEMPLATE_MANAGER_MESSAGE_LANGUAGE=fr
# For staff activation wa.me link: use the actual WhatsApp number in E.164 digits (no +). Do NOT use WHATSAPP_PHONE_NUMBER_ID here.
WHATSAPP_ACTIVATION_WA_PHONE=212784476751

# =============================================================================
# MIYA / MASTRA
# =============================================================================
MIYA_MASTRA_URL=https://mizan-miya-mastra.server.mastra.cloud
MIYA_MASTRA_AGENT_ID=miya
MIYA_MASTRA_API_KEY=

# =============================================================================
# FISH AUDIO — Miya voice (https://fish.audio/app/)
# =============================================================================
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro

# =============================================================================
# OPENAI (For AI features)
# =============================================================================
OPENAI_API_KEY=sk-proj-...your-key

# =============================================================================
# STRIPE (Billing)
# =============================================================================
# Currency for pricing cards (MAD for Morocco, USD otherwise).
BILLING_CURRENCY=MAD
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform Admin (/admin) — comma-separated emails
PLATFORM_OPS_EMAILS=
PLATFORM_OPS_SUPERUSER_EMAILS=
# Password used to sign in at /admin (creates the user if missing; resets on restart)
PLATFORM_OPS_PASSWORD=
# Optional — when unset, plans still render with a "Contact sales" CTA.
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_GROWTH_MONTHLY=price_...
# STRIPE_PRICE_GROWTH_YEARLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# =============================================================================
# SQUARE POS (OAuth + Webhooks)
# =============================================================================
# Use 'production' for live accounts or 'sandbox' for testing.
SQUARE_ENV=production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Must match the redirect URL configured in Square Developer Dashboard.
# Example: https://api.heymizan.ai/api/settings/square/oauth/callback/
SQUARE_REDIRECT_URI=
# Comma-separated scopes; keep minimal.
SQUARE_SCOPES=PAYMENTS_READ,ORDERS_READ,ITEMS_READ,MERCHANT_PROFILE_READ
SQUARE_API_VERSION=2024-01-18
# Webhook signature key from Square webhook subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the exact notification URL configured in Square (used for signature verification).
# Example: https://api.heymizan.ai/api/pos/webhooks/square/
SQUARE_WEBHOOK_NOTIFICATION_URL=

# =============================================================================
# FIREBASE (Push Notifications)
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_KEY={}

# =============================================================================
# FRONTEND URL
# =============================================================================
FRONTEND_URL=https://app.heymizan.ai

# =============================================================================
# GOOGLE CALENDAR (OAuth)
# =============================================================================
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Redirect URI must EXACTLY match GOOGLE_OAUTH_REDIRECT_URI below.
# OAuth consent screen scopes: openid, email, profile, ../auth/calendar.events
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.heymizan.ai/api/integrations/google-calendar/callback/

# =============================================================================
# S3 MEDIA STORAGE (private bucket + EC2 IAM role)
# =============================================================================
# Attach MizanEC2S3Role to the EC2 instance — do NOT set AWS access keys here.
AWS_STORAGE_BUCKET_NAME=mizan-ai-production-media
AWS_S3_REGION_NAME=eu-central-1
AWS_QUERYSTRING_AUTH=true

# =============================================================================
# SECURITY
# =============================================================================
SECURE_SSL_REDIRECT=True

# =============================================================================
# MIYA / MASTRA CLOUD
# =============================================================================
MIYA_AGENT_PROVIDER=mastra
MIYA_MASTRA_URL=https://mizan-miya-mastra.server.mastra.cloud
MIYA_MASTRA_AGENT_ID=miya
# NOT from Mastra dashboard — you define this shared bridge secret yourself.
# Must be IDENTICAL on Django (here) and Mastra Cloud (deployed via Miya-V2).
# Keep in sync with mizan-backend/.env → node scripts/sync-env-production.mjs
MIYA_MASTRA_API_KEY=mizan-mastra-bridge-2026
MIYA_MASTRA_TIMEOUT=120
MIYA_WHATSAPP_ENABLED=True
MIYA_WHATSAPP_VOICE_DEFAULT=False
# Meta webhook on Mastra — Django skips in-process Miya WhatsApp chat
MIYA_WHATSAPP_MASTRA_CHANNEL=True
MIYA_ASYNC_CHAT=True
MIYA_CACHE_TTL_WHATSAPP_CTX=300
MIYA_CACHE_TTL_TOOL=90
MIYA_CACHE_TTL_CONTEXT=120
MIYA_MASTRA_HEALTH_CACHE_TTL=30
MIYA_AGENT_API_BASE=https://api.heymizan.ai
PUBLIC_API_BASE_URL=https://api.heymizan.ai
